# ==========================================
# Blog0fwindchan 环境变量配置模板
# ==========================================
# 
# 使用方法：
# 1. 复制本文件为 .env
# 2. 填写所有必填项
# 3. 确认 .env 已在 .gitignore 中（永远不要提交到 Git！）
#
# 生成密钥的方法：
# python -c "import secrets; print(secrets.token_hex(32))"
# ==========================================

# ------------------------------------------
# 🔒 JWT 认证配置（必填）
# ------------------------------------------
# JWT 密钥：至少 32 字符的随机字符串
# ⚠️ 警告：泄露此密钥将导致认证系统完全失效！
# 生成方法：python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=your-super-secret-jwt-key-at-least-32-chars-long-change-this

# ------------------------------------------
# 🌐 CORS 跨域配置（必填）
# ------------------------------------------
# 允许跨域访问的前端域名，多个域名用英文逗号分隔
# ⚠️ 不要使用通配符 *，必须显式列出所有域名
#
# 本地开发示例：
# CORS_ORIGINS=http://localhost:5173
#
# 生产环境示例：
# CORS_ORIGINS=https://blog.windchan.com,https://www.windchan.com
#
# 多环境混合示例：
# CORS_ORIGINS=http://localhost:5173,https://blog.windchan.com
CORS_ORIGINS=http://localhost:5173

# ------------------------------------------
# 🐛 Flask 调试模式（可选）
# ------------------------------------------
# 开发环境：设置为 True 以启用详细错误信息和自动重载
# 生产环境：必须设置为 False 或删除此行
# ⚠️ 生产环境开启 DEBUG 会泄露敏感信息！
#
# 开发环境：
FLASK_DEBUG=True
#
# 生产环境（推荐）：
# FLASK_DEBUG=False
# 或直接删除本行

# ------------------------------------------
# 🔌 Flask 服务端口（可选）
# ------------------------------------------
# Flask 应用监听的端口号
# 默认值：5000
# FLASK_PORT=5000

# ------------------------------------------
# 📊 日志配置（可选）
# ------------------------------------------
# 日志级别：DEBUG, INFO, WARNING, ERROR, CRITICAL
# 开发环境推荐：DEBUG
# 生产环境推荐：WARNING
# LOG_LEVEL=WARNING

# ------------------------------------------
# 📁 上传配置（可选）
# ------------------------------------------
# 上传文件最大大小（字节）
# 默认：10485760 (10MB)
# MAX_UPLOAD_SIZE=10485760

# ------------------------------------------
# 🔐 密码哈希配置（可选，高级用户）
# ------------------------------------------
# 密码哈希算法：pbkdf2, scrypt, argon2
# 默认：werkzeug 的 pbkdf2:sha256
# 推荐：scrypt 或 argon2（需安装 argon2-cffi）
# PASSWORD_HASH_METHOD=scrypt

# ------------------------------------------
# 📧 邮件配置（未来功能，预留）
# ------------------------------------------
# SMTP 服务器配置（如需启用邮件通知功能）
# MAIL_SERVER=smtp.example.com
# MAIL_PORT=587
# MAIL_USE_TLS=True
# MAIL_USERNAME=your-email@example.com
# MAIL_PASSWORD=your-email-password

# ------------------------------------------
# 🗄️ 数据库配置（高级）
# ------------------------------------------
# 默认使用 SQLite，如需切换到 PostgreSQL/MySQL，配置以下项：
# DATABASE_URL=postgresql://user:password@localhost/dbname
# 或
# DATABASE_URL=mysql://user:password@localhost/dbname

# ------------------------------------------
# ☁️ 云存储配置（未来功能，预留）
# ------------------------------------------
# 如需使用云存储（OSS/S3）替代本地存储
# CLOUD_STORAGE_ENABLED=False
# CLOUD_STORAGE_BUCKET=your-bucket-name
# CLOUD_STORAGE_ACCESS_KEY=your-access-key
# CLOUD_STORAGE_SECRET_KEY=your-secret-key
